{
  "additionalProperties": false,
  "description": "A site profilja (`site`): a crawl kiindulása és amit a site-ról megállapított.",
  "properties": {
    "crawled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crawled At"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "home_urls": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Home Urls"
    },
    "https_redirect": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Https Redirect"
    },
    "https_redirect_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Https Redirect Status"
    },
    "languages": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Languages"
    },
    "market_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Scope"
    },
    "market_scope_city": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Scope City"
    },
    "page_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Count"
    },
    "render_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Mode"
    },
    "robots_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Robots Status"
    },
    "robots_txt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Robots Txt"
    },
    "schema_version": {
      "default": "1.12",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_url": {
      "title": "Seed Url",
      "type": "string"
    },
    "target_country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Country"
    },
    "target_country_candidates": {
      "default": null,
      "title": "Target Country Candidates"
    },
    "target_country_confidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Country Confidence"
    },
    "tech": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tech"
    },
    "tech_signals": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tech Signals"
    },
    "trailing_slash": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trailing Slash"
    }
  },
  "required": [
    "domain",
    "seed_url"
  ],
  "title": "Site",
  "type": "object",
  "x-module": "crawl",
  "x-schema-version": "1.12"
}
