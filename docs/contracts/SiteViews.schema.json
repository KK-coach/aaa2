{
  "$defs": {
    "EntityRelation": {
      "additionalProperties": false,
      "description": "Egy entitás egy kapcsolata a nézetben: az él típusa, iránya (`→` kifelé, `←` befelé) és\na másik entitás.",
      "properties": {
        "direction": {
          "enum": [
            "→",
            "←"
          ],
          "title": "Direction",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "direction",
        "entity_id",
        "entity"
      ],
      "title": "EntityRelation",
      "type": "object"
    },
    "EntityView": {
      "additionalProperties": false,
      "description": "Egy entitás a site-áttekintőben: rang és súly, a kapcsolatai, a fő oldalai és a csak\nemlítő oldalak. `name`: a megtartott név; `other_names`: a többi nyelvű név.",
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "main_pages": {
          "items": {
            "type": "string"
          },
          "title": "Main Pages",
          "type": "array"
        },
        "mention_only_pages": {
          "items": {
            "type": "string"
          },
          "title": "Mention Only Pages",
          "type": "array"
        },
        "mentions": {
          "title": "Mentions",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "other_names": {
          "items": {
            "$ref": "#/$defs/OtherName"
          },
          "title": "Other Names",
          "type": "array"
        },
        "pages": {
          "title": "Pages",
          "type": "integer"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/EntityRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtype"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "entity_id",
        "name",
        "type",
        "rank",
        "weight",
        "pages",
        "mentions"
      ],
      "title": "EntityView",
      "type": "object"
    },
    "FindingView": {
      "additionalProperties": false,
      "description": "Egy megállapítás a megjelenítéshez: a tárolt mezők mellett a típus címkéje, az entitás\nneve és az érintett oldalak. A `recommendation` (javaslat) ma nem keletkezik.",
      "properties": {
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "evidence": {
          "default": null,
          "title": "Evidence"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "pages": {
          "items": {
            "type": "string"
          },
          "title": "Pages",
          "type": "array"
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "type",
        "label",
        "severity",
        "summary"
      ],
      "title": "FindingView",
      "type": "object"
    },
    "HeadingEntity": {
      "additionalProperties": false,
      "description": "Egy headingben álló entitás és a kapcsolata az oldal fő entitásához: `main` (maga a fő\nentitás), `related` (él vagy közös szülő a gráfban), `unrelated`, `no_main` (az oldalnak\nnincs fő entitása).",
      "properties": {
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "relation": {
          "enum": [
            "main",
            "related",
            "unrelated",
            "no_entity",
            "no_main"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity",
        "relation"
      ],
      "title": "HeadingEntity",
      "type": "object"
    },
    "HeadingOutside": {
      "additionalProperties": false,
      "description": "Egy H1 a fő tartalmon kívül: `cookie` (cookie- vagy consent-elem), `dialog` (popup,\nmodális ablak), `chrome` (fejléc, menü, lábléc, oldalsáv).",
      "properties": {
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "where": {
          "enum": [
            "cookie",
            "dialog",
            "chrome"
          ],
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "where",
        "text"
      ],
      "title": "HeadingOutside",
      "type": "object"
    },
    "HeadingView": {
      "additionalProperties": false,
      "description": "Egy heading a fában (H1–H6) a szakaszával: az entitásai, a legerősebb kapcsolat a fő\nentitáshoz (`no_entity`: nincs benne entitás), a szakasz saját és teljes szószáma, az üres\nszakasz (`empty`: a DOM-ban sincs alatta szöveg és tartalmi elem), a szöveg nélküli, de\ntartalmi elemet (kép, űrlap, táblázat) tartalmazó szakasz (`media_only`) és a kihagyott\nszint jelzése, a sablon-heading jelzése (`template`: több\noldalcsoportban ismétlődő heading, nem lehet megállapítás tárgya), és az alárendelt\nheadingek.",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/HeadingView"
          },
          "title": "Children",
          "type": "array"
        },
        "empty": {
          "default": false,
          "title": "Empty",
          "type": "boolean"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/HeadingEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "media_only": {
          "default": false,
          "title": "Media Only",
          "type": "boolean"
        },
        "relation": {
          "enum": [
            "main",
            "related",
            "unrelated",
            "no_entity",
            "no_main"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "skipped_level": {
          "default": false,
          "title": "Skipped Level",
          "type": "boolean"
        },
        "template": {
          "default": false,
          "title": "Template",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "total_words": {
          "default": 0,
          "title": "Total Words",
          "type": "integer"
        },
        "words": {
          "default": 0,
          "title": "Words",
          "type": "integer"
        }
      },
      "required": [
        "level",
        "text",
        "relation"
      ],
      "title": "HeadingView",
      "type": "object"
    },
    "OtherName": {
      "additionalProperties": false,
      "description": "Az entitás egy neve a site elsődleges nyelvétől eltérő nyelven, a forrásával.",
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "name",
        "source"
      ],
      "title": "OtherName",
      "type": "object"
    },
    "PageMention": {
      "additionalProperties": false,
      "description": "Egy oldalon említett további entitás a súlyával.",
      "properties": {
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "entity_id",
        "entity",
        "weight"
      ],
      "title": "PageMention",
      "type": "object"
    },
    "PageView": {
      "additionalProperties": false,
      "description": "Egy oldal a nézetben: szerep, canonical-döntés, a fő entitás a bizonyítékaival, a\nmásodlagos entitások, a H1 és a title megnevezi-e a fő entitást, a további említett\nentitások, az oldal megállapításai, a jelzések (`notes`: a kinyerés nem nevezett meg fő\ntémát; a nyelvi pár fő entitása eltér), és a heading-fa (a sablon- és chrome-headingek nélkül;\n`h1_outside`: H1 a fő tartalmon kívül; `h1_justified`: több H1 indokolt-e, None egy H1-nél).",
      "properties": {
        "canonical_issue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Issue"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "strong",
                "medium",
                "weak"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "evidence": {
          "default": null,
          "title": "Evidence"
        },
        "evidence_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Text"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "h1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H1"
        },
        "h1_justified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H1 Justified"
        },
        "h1_outside": {
          "items": {
            "$ref": "#/$defs/HeadingOutside"
          },
          "title": "H1 Outside",
          "type": "array"
        },
        "headings": {
          "items": {
            "$ref": "#/$defs/HeadingView"
          },
          "title": "Headings",
          "type": "array"
        },
        "in_h1": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In H1"
        },
        "in_title": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Title"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        },
        "main_entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Entity"
        },
        "main_entity_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Entity Id"
        },
        "main_entity_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Entity Type"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "other_mentions": {
          "items": {
            "$ref": "#/$defs/PageMention"
          },
          "title": "Other Mentions",
          "type": "array"
        },
        "page_id": {
          "title": "Page Id",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "default": "1.7",
          "title": "Schema Version",
          "type": "string"
        },
        "secondary": {
          "items": {
            "type": "string"
          },
          "title": "Secondary",
          "type": "array"
        },
        "support_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Kind"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "url",
        "role"
      ],
      "title": "PageView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A riport bemenete egy site-ra: a megállapítások, az entitások és az oldalak nézete,\nverziózva (`schema_version`).",
  "properties": {
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityView"
      },
      "title": "Entities",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/FindingView"
      },
      "title": "Findings",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageView"
      },
      "title": "Pages",
      "type": "array"
    },
    "schema_version": {
      "default": "1.7",
      "title": "Schema Version",
      "type": "string"
    },
    "site": {
      "title": "Site",
      "type": "string"
    }
  },
  "required": [
    "site"
  ],
  "title": "SiteViews",
  "type": "object",
  "x-module": "findings",
  "x-schema-version": "1.7"
}
