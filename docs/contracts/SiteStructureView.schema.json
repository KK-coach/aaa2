      },
      "title": "Menu",
      "type": "array"
    },
    "schema_version": {
      "default": "1.19",
      "title": "Schema Version",
      "type": "string"
    },
    "unreachable": {
      "items": {
        "type": "string"
      },
      "title": "Unreachable",
      "type": "array"
    },
    "url_deep": {
      "default": 0,
      "title": "Url Deep",
      "type": "integer"
    },
    "url_hierarchical": {
      "default": false,
      "title": "Url Hierarchical",
      "type": "boolean"
    },
    "url_pages": {
      "default": 0,
      "title": "Url Pages",
      "type": "integer"
    },
    "url_with_parent": {
      "default": 0,
      "title": "Url With Parent",
      "type": "integer"
    }
