      "description": "Egy nyelv oldalainak kattintási mélysége a nyelv kezdőoldalától (`home`), vödrönként\n(0, 1, 2, 3, 4+, elérhetetlen).",
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "home": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "schema_version": {
          "default": "1.19",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "lang"
      ],
      "title": "DepthDistribution",
      "type": "object"
    },
    "MenuItemView": {
      "additionalProperties": false,
      "description": "A site menüfájának egy menüpontja a nézetben: a nyelv, a terület, a szint, a\nhorgonyszöveg, a cím, a szülő menüpont (horgonyszöveg), a céloldal fő entitása és szerepe\n(ha a cél a készlet oldala), a céloldal kattintási mélysége a saját nyelvű kezdőoldaltól,\nnoindex-e a céloldal (`target_noindex`; tény, nem megállapítás), és hogy hány oldalon áll a\nterületet hordozó oldalak közül.",
      "properties": {
        "anchor": {
          "title": "Anchor",
          "type": "string"
        },
        "area": {
          "enum": [
            "header",
            "footer",
            "sidebar"
          ],
          "title": "Area",
          "type": "string"
        },
        "area_pages": {
          "title": "Area Pages",
          "type": "integer"
        },
        "click_depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Click Depth"
        },
        "in_set": {
          "default": false,
          "title": "In Set",
          "type": "boolean"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "main_entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Entity"
        },
        "marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "pages": {
          "title": "Pages",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "schema_version": {
          "default": "1.19",
          "title": "Schema Version",
          "type": "string"
        },
        "target_noindex": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Noindex"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
