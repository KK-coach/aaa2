      "required": [
        "lang",
        "area",
        "level",
        "anchor",
        "pages",
        "area_pages"
      ],
      "title": "MenuItemView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A site belső struktúrája a nézetben: a menüfa, a mélység-eloszlás nyelvenként, a\nkezdőoldalról elérhetetlen oldalak, és az URL-hierarchia mért feltétele (`url_pages`: a nem\nkezdőoldalak száma, `url_deep`: ebből legalább két útvonal-szakaszon áll, `url_with_parent`:\nezekből a szülő útvonalon létező oldal áll; `url_hierarchical`: az URL-szülő értelmezhető).",
  "properties": {
    "depth": {
      "items": {
