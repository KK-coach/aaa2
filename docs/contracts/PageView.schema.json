    "SchemaAbout": {
      "additionalProperties": false,
      "description": "Az oldal schema.org `about` értéke: a hivatkozás saját neve, az `@id`, név nélküli\n`@id`-hivatkozásnál a csomópontjainak összes neve a készletben (`names`), és mire mutat, ha\negyértelmű: az entitás, a neve az oldal nyelvén, a típusa, és azonos-e az oldal fő\nentitásával (None: nem oldható fel, vagy nincs fő entitás).",
      "properties": {
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "names": {
          "items": {
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        },
        "same_as_main": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Same As Main"
        },
        "schema_version": {
          "default": "1.20",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "title": "SchemaAbout",
      "type": "object"
    },
    "TitleField": {
      "additionalProperties": false,
      "description": "Az oldal egy schema.org címmezője: a mező és a típus (`field`, pl. „headline (Article)”)\nés a szövege a site-utótag nélkül.",
