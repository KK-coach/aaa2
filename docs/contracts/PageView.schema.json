{
  "$defs": {
    "HeadingEntity": {
      "additionalProperties": false,
      "description": "Egy headingben álló entitás és a kapcsolata az oldal fő entitásához: `main` (maga a fő\nentitás), `related` (él vagy közös szülő a gráfban), `unrelated`, `no_main` (az oldalnak\nnincs fő entitása).",
      "properties": {
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "relation": {
          "enum": [
            "main",
            "related",
            "unrelated",
            "no_entity",
            "no_main"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.20",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity",
        "relation"
      ],
      "title": "HeadingEntity",
      "type": "object"
    },
    "HeadingOutside": {
      "additionalProperties": false,
      "description": "Egy H1 a fő tartalmon kívül: `cookie` (cookie- vagy consent-elem), `dialog` (popup,\nmodális ablak), `chrome` (fejléc, menü, lábléc, oldalsáv).",
      "properties": {
        "schema_version": {
          "default": "1.20",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "where": {
          "enum": [
            "cookie",
            "dialog",
            "chrome"
          ],
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "where",
        "text"
      ],
      "title": "HeadingOutside",
      "type": "object"
    },
    "HeadingView": {
      "additionalProperties": false,
      "description": "Egy heading a fában (H1–H6) a szakaszával: az entitásai, a legerősebb kapcsolat a fő\nentitáshoz (`no_entity`: nincs benne entitás), a szakasz saját és teljes szószáma, az üres\nszakasz (`empty`: a DOM-ban sincs alatta szöveg és tartalmi elem), a szöveg nélküli, de\ntartalmi elemet (kép, űrlap, táblázat) tartalmazó szakasz (`media_only`) és a kihagyott\nszint jelzése, a sablon-heading jelzése (`template`: több\noldalcsoportban ismétlődő heading, nem lehet megállapítás tárgya), és az alárendelt\nheadingek.",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/HeadingView"
          },
          "title": "Children",
          "type": "array"
        },
        "empty": {
          "default": false,
          "title": "Empty",
          "type": "boolean"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/HeadingEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "media_only": {
          "default": false,
          "title": "Media Only",
          "type": "boolean"
        },
        "relation": {
          "enum": [
            "main",
            "related",
            "unrelated",
            "no_entity",
            "no_main"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.20",
          "title": "Schema Version",
          "type": "string"
        },
        "skipped_level": {
          "default": false,
          "title": "Skipped Level",
          "type": "boolean"
        },
        "template": {
          "default": false,
          "title": "Template",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "total_words": {
          "default": 0,
          "title": "Total Words",
          "type": "integer"
        },
        "words": {
          "default": 0,
          "title": "Words",
          "type": "integer"
        }
      },
      "required": [
        "level",
        "text",
        "relation"
      ],
      "title": "HeadingView",
      "type": "object"
    },
    "HubChild": {
      "additionalProperties": false,
      "description": "Egy hub-oldal egy gyereke: az URL-je, a szerepe, honnan ismert (`source`: menü,\ntartalom vagy mindkettő), és visszalinkel-e a tartalmából a hubra.",
      "properties": {
        "links_back": {
          "default": false,
          "title": "Links Back",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
