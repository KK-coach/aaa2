{
  "$defs": {
    "HeadingEntity": {
      "additionalProperties": false,
      "description": "Egy headingben álló entitás és a kapcsolata az oldal fő entitásához: `main` (maga a fő\nentitás), `related` (él vagy közös szülő a gráfban), `unrelated`, `no_main` (az oldalnak\nnincs fő entitása).",
      "properties": {
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "relation": {
          "enum": [
            "main",
            "related",
            "unrelated",
            "no_entity",
            "no_main"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.3",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity",
        "relation"
      ],
      "title": "HeadingEntity",
      "type": "object"
    },
    "HeadingOutside": {
      "additionalProperties": false,
      "description": "Egy H1 a fő tartalmon kívül: `cookie` (cookie- vagy consent-elem), `dialog` (popup,\nmodális ablak), `chrome` (fejléc, menü, lábléc, oldalsáv).",
      "properties": {
        "schema_version": {
          "default": "1.3",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "where": {
          "enum": [
            "cookie",
            "dialog",
            "chrome"
          ],
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "where",
        "text"
      ],
      "title": "HeadingOutside",
      "type": "object"
    },
    "HeadingView": {
      "additionalProperties": false,
      "description": "Egy heading a fában (H1–H6) a szakaszával: az entitásai, a legerősebb kapcsolat a fő\nentitáshoz (`no_entity`: nincs benne entitás), a szakasz saját és teljes szószáma, az üres\nszakasz és a kihagyott szint jelzése, a sablon-heading jelzése (`template`: több\noldalcsoportban ismétlődő heading, nem lehet megállapítás tárgya), és az alárendelt\nheadingek.",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/HeadingView"
          },
          "title": "Children",
          "type": "array"
        },
        "empty": {
          "default": false,
          "title": "Empty",
          "type": "boolean"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/HeadingEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "relation": {
          "enum": [
            "main",
            "related",
            "unrelated",
            "no_entity",
            "no_main"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.3",
          "title": "Schema Version",
          "type": "string"
        },
        "skipped_level": {
          "default": false,
          "title": "Skipped Level",
          "type": "boolean"
        },
        "template": {
          "default": false,
          "title": "Template",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "total_words": {
          "default": 0,
          "title": "Total Words",
          "type": "integer"
        },
        "words": {
          "default": 0,
          "title": "Words",
          "type": "integer"
        }
      },
      "required": [
        "level",
        "text",
        "relation"
      ],
      "title": "HeadingView",
      "type": "object"
    },
    "PageMention": {
      "additionalProperties": false,
      "description": "Egy oldalon említett további entitás a súlyával.",
      "properties": {
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.3",
          "title": "Schema Version",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "entity_id",
        "entity",
        "weight"
      ],
      "title": "PageMention",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Egy oldal a nézetben: szerep, canonical-döntés, a fő entitás a bizonyítékaival, a\nmásodlagos entitások, a H1 és a title megnevezi-e a fő entitást, a további említett\nentitások, az oldal megállapításai, és a heading-fa (a sablon- és chrome-headingek nélkül;\n`h1_outside`: H1 a fő tartalmon kívül; `h1_justified`: több H1 indokolt-e, None egy H1-nél).",
  "properties": {
    "canonical_issue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Issue"
    },
    "confidence": {
      "anyOf": [
        {
          "enum": [
            "strong",
            "medium",
            "weak"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Of"
    },
    "evidence": {
      "default": null,
      "title": "Evidence"
    },
    "evidence_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Text"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "h1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "H1"
    },
    "h1_justified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "H1 Justified"
    },
    "h1_outside": {
      "items": {
        "$ref": "#/$defs/HeadingOutside"
      },
      "title": "H1 Outside",
      "type": "array"
    },
    "headings": {
      "items": {
        "$ref": "#/$defs/HeadingView"
      },
      "title": "Headings",
      "type": "array"
    },
    "in_h1": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "In H1"
    },
    "in_title": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "In Title"
    },
    "lang": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lang"
    },
    "main_entity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Main Entity"
    },
    "main_entity_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Main Entity Id"
    },
    "main_entity_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Main Entity Type"
    },
    "other_mentions": {
      "items": {
        "$ref": "#/$defs/PageMention"
      },
      "title": "Other Mentions",
      "type": "array"
    },
    "page_id": {
      "title": "Page Id",
      "type": "integer"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary": {
      "items": {
        "type": "string"
      },
      "title": "Secondary",
      "type": "array"
    },
    "support_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Kind"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "page_id",
    "url",
    "role"
  ],
  "title": "PageView",
  "type": "object",
  "x-module": "findings",
  "x-schema-version": "1.3"
}
