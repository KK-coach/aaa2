   "text": "Dynamic Group Header - 1"
  },
  {
   "id": "b148",
   "kind": "other",
   "heading_path": [
    "Accordion",
    "Dynamic accordion"
   ],
   "text": "Dynamic Group Header - 2"
  },
  {
   "id": "b149",
   "kind": "list_item",
   "heading_path": [
    "Accordion",
    "Dynamic accordion"
   ],
   "text": "template"
  },
  {
   "id": "b150",
   "kind": "list_item",
   "heading_path": [
    "Accordion",
    "Dynamic accordion"
   ],
   "text": "component"
  },
  {
   "id": "b151",
   "kind": "code",
   "heading_path": [
    "Accordion",
    "Dynamic accordion"
   ],
   "text": "<p>\n<button type = \"button\" class = \"btn btn-primary btn-sm\" ( click ) = \"addGroupItem()\" >\nAdd Group Item\n</button>\n</p>\n\n<accordion>\n@for (group of groups; track group) {\n<accordion-group [ heading ] = \"group.title\" >\n{{ group?.content }}\n</accordion-group>\n}\n</accordion>"
  },
  {
   "id": "b152",
   "kind": "code",
   "heading_path": [
    "Accordion",
    "Dynamic accordion"
   ],
   "text": "import { Component , ChangeDetectionStrategy } from '@angular/core' ;\n\n@Component ({\n// eslint-disable-next-line @angular-eslint/component-selector\nselector : 'demo-accordion-dynamic' ,\ntemplateUrl : './dynamic.html' ,\nchangeDetection : ChangeDetectionStrategy . Eager ,\nstandalone : false\n})\nexport class DemoAccordionDynamicComponent {\ngroups = [\n{\ntitle : 'Dynamic Group Header - 1' ,\ncontent : 'Dynamic Group Body - 1'\n},\n{\ntitle : 'Dynamic Group Header - 2' ,\ncontent : 'Dynamic Group Body - 2'\n}\n];\n\naddGroupItem (): void {\nthis . groups . push ({\ntitle : ` Dynamic Group Header - $ { this . groups . length + 1 }`,\ncontent : ` Dynamic Group Body - $ { this . groups . length + 1 }`\n});\n}\n}"
  },
  {
   "id": "b153",
   "kind": "heading",
   "heading_path": [
    "Accordion",
    "Dynamic body content"
   ],
   "text": "Dynamic body content"
