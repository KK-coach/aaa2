   ],
   "text": "<accordion [ isAnimated ] = \"true\" >\n<accordion-group heading = \"Static Header\" >\nThis content is straight in the template.\n</accordion-group>\n<accordion-group heading = \"Another group\" >\n<p> Some content </p>\n</accordion-group>\n<accordion-group heading = \"Another group\" >\n<p> Some content </p>\n</accordion-group>\n<accordion-group heading = \"Another group\" >\n<p> Some content </p>\n</accordion-group>\n</accordion>"
  },
  {
