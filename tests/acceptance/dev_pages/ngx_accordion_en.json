   ],
   "text": "component"
  },
  {
   "id": "b114",
   "kind": "code",
   "heading_path": [
    "Accordion",
    "Group opening event"
   ],
   "text": "<accordion>\n<accordion-group heading = \"Group without isOpenChange event listener\" >\n<p> Some content </p>\n</accordion-group>\n<accordion-group heading = \"Group with isOpenChange event listener\" ( isOpenChange ) = \"log($event)\" >\n<p> Some content </p>\n</accordion-group>\n<accordion-group heading = \"Group with isOpenChange event listener\" ( isOpenChange ) = \"log($event)\" >\n<p> Some content </p>\n</accordion-group>\n</accordion>"
  },
  {
   "id": "b115",
   "kind": "code",
   "heading_path": [
    "Accordion",
    "Group opening event"
   ],
   "text": "import { Component , ChangeDetectionStrategy } from '@angular/core' ;\n\n@Component ({\n// eslint-disable-next-line @angular-eslint/component-selector\nselector : 'demo-accordion-open-event' ,\ntemplateUrl : './open-event.html' ,\nchangeDetection : ChangeDetectionStrategy . Eager ,\nstandalone : false\n})\nexport class DemoAccordionOpenEventComponent {\nlog ( event : boolean ) {\nconsole . log (` Accordion has been $ { event ? 'opened' : 'closed' }`);\n}\n}"
  },
  {
   "id": "b116",
