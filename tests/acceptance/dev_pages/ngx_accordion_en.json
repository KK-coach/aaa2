   "heading_path": [
    "Accordion",
    "Manual toggle"
   ],
   "text": "<p>\n<button type = \"button\" class = \"btn btn-primary btn-sm\"\n( click ) = \"isOpen = !isOpen\" > Toggle last panel\n</button>\n</p>\n\n<accordion>\n<accordion-group heading = \"Content 1\" >\n<p> accordion 1 </p>\n</accordion-group>\n<accordion-group heading = \"Content 2\" >\n<p> accordion 2 </p>\n</accordion-group>\n<accordion-group [ isOpen ] = \"isOpen\" heading = \"Last panel\" >\n<p> accordion 3 </p>\n</accordion-group>\n</accordion>"
  },
