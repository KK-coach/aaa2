    {
      "id": "b2",
      "kind": "paragraph",
      "text": "Il 17 e 18 ottobre la Fortezza di Montalcino ospita la dodicesima edizione di Calici d'Autunno, la festa del Brunello di Montalcino e del Rosso di Montalcino.",
      "heading_path": [
        "Calici d'Autunno 2026"
      ]
    },
    {
      "id": "b3",
      "kind": "heading",
      "level": 2,
      "text": "Il programma",
      "heading_path": [
        "Calici d'Autunno 2026",
        "Il programma"
      ]
    },
    {
      "id": "b4",
      "kind": "list_item",
      "text": "Degustazione guidata di Sangiovese in purezza con i produttori della Val d'Orcia",
      "heading_path": [
        "Calici d'Autunno 2026",
        "Il programma"
      ]
    },
    {
      "id": "b5",
      "kind": "list_item",
      "text": "Laboratorio di abbinamento con pecorino di Pienza a cura della chef Lucia Ferri",
      "heading_path": [
        "Calici d'Autunno 2026",
        "Il programma"
      ]
    },
    {
      "id": "b6",
      "kind": "list_item",
      "text": "Passeggiata nel borgo e visita all'abbazia di Sant'Antimo",
      "heading_path": [
        "Calici d'Autunno 2026",
        "Il programma"
      ]
    },
    {
