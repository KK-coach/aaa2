    {
      "id": "b1",
      "kind": "heading",
      "level": 1,
      "text": "Tabs",
      "heading_path": [
        "Tabs"
      ]
    },
    {
      "id": "b2",
      "kind": "paragraph",
      "text": "The Tabs component organizes content into panels that the user switches between. It implements the WAI-ARIA Tabs pattern and builds on the Collapse directive for animated panels.",
      "heading_path": [
        "Tabs"
      ]
    },
    {
      "id": "b3",
      "kind": "heading",
      "level": 2,
      "text": "Installation",
      "heading_path": [
        "Tabs",
        "Installation"
      ]
    },
    {
      "id": "b4",
      "kind": "code",
      "text": "npm install @atlas-ui/tabs",
      "heading_path": [
        "Tabs",
        "Installation"
      ]
    },
    {
      "id": "b5",
      "kind": "paragraph",
      "text": "Atlas UI supports Angular 17 and later with Bootstrap 5 and Tailwind CSS themes. It is written in TypeScript and uses RxJS for tab change events.",
      "heading_path": [
        "Tabs",
        "Installation"
      ]
    },
    {
      "id": "b6",
      "kind": "heading",
      "level": 2,
      "text": "API",
      "heading_path": [
        "Tabs",
        "API"
      ]
    },
    {
      "id": "b7",
      "kind": "list_item",
      "text": "TabsModule – import it into your NgModule.",
      "heading_path": [
        "Tabs",
        "API"
      ]
    },
    {
      "id": "b8",
      "kind": "list_item",
      "text": "TabsetComponent – the container. Inputs: vertical, justified, type.",
      "heading_path": [
        "Tabs",
        "API"
      ]
    },
    {
      "id": "b9",
      "kind": "list_item",
      "text": "TabDirective – a single tab. Outputs: selectTab, deselect.",
      "heading_path": [
        "Tabs",
        "API"
      ]
    },
    {
      "id": "b10",
      "kind": "list_item",
      "text": "TabsetConfig – default values for all tabsets.",
      "heading_path": [
        "Tabs",
        "API"
      ]
    },
    {
      "id": "b11",
      "kind": "heading",
      "level": 2,
      "text": "Example",
      "heading_path": [
        "Tabs",
        "Example"
      ]
    },
    {
      "id": "b12",
      "kind": "code",
      "text": "import { Component } from '@angular/core';\n\n@Component({\n  selector: 'demo-tabs',\n  template: '<tabset><tab heading=\"Home\">First</tab></tabset>'\n})\nexport class DemoTabsComponent {\n  activeTab = 0;\n}",
      "heading_path": [
        "Tabs",
        "Example"
      ]
    },
